# Токен бота от @BotFather
BOT_TOKEN=1234567890:AAExampleTokenFromBotFather

# Ваш Telegram ID (или несколько ID через запятую). Узнать можно командой /id после запуска бота или у @userinfobot
ADMIN_IDS=123456789

# @username вашего канала (например @my_channel) или числовой ID (-1001234567890)
CHANNEL_ID=@your_channel

# ID закрытой группы-форума (с включёнными "Темами"), куда для каждого подписчика
# будет создаваться отдельный чат-тема. Если оставить пустым — сообщения придут в ЛС админу (ответ через Reply).
FEEDBACK_GROUP_ID=

# (Необязательно) Личный токен GitHub (fine-grained PAT с правом Contents: Read & Write на этот репозиторий),
# чтобы обновлять кнопки Mini App на GitHub Pages прямо из /admin в Telegram.
GITHUB_TOKEN=
GITHUB_REPO=KOLRNCH/tg-channel-bot
GITHUB_BRANCH=main
